msgstr "Kopiere Dateien … %1$s von %2$s (%3$s)"

#: includes/Export/Job.php:256
msgid "Compressing the database and writing the report …"
msgstr "Komprimiere die Datenbank und schreibe den Bericht …"

#: includes/Export/Job.php:257
msgid "Export finished."
msgstr "Export abgeschlossen."

#: includes/Export/Report.php:31
msgid "Created"
msgstr "Erstellt"

#: includes/Export/Report.php:32
msgid "Source"
msgstr "Quelle"

#: includes/Export/Report.php:38
msgid "indexing discouraged"
msgstr "Indexierung verhindert"

#: includes/Export/Report.php:39
msgid "indexing allowed"
msgstr "Indexierung erlaubt"

#: includes/Export/Report.php:40
msgid "as on the local site"
msgstr "wie auf der lokalen Seite"

#: includes/Export/Report.php:45
msgid "Contents"
msgstr "Inhalt"

#: includes/Export/Report.php:49
#, php-format
msgid "The complete site (%1$s files, %2$s). Upload the contents of this folder into the web root of the target."
msgstr "Die komplette Website (%1$s Dateien, %2$s). Lade den Inhalt dieses Ordners in das Webroot des Ziels hoch."

#: includes/Export/Report.php:54
msgid "Database dump for phpMyAdmin (Import tab). Tables with the same names are replaced."
msgstr "Datenbank-Dump für phpMyAdmin (Reiter „Importieren“). Gleichnamige Tabellen werden ersetzt."

#: includes/Export/Report.php:56
msgid "Only for a new installation: enter the database credentials of the target, rename it to wp-config.php and upload it. It has new security keys, debugging switched off and the table prefix of the dump."
msgstr "Nur für eine neue Installation: Zugangsdaten der Zieldatenbank eintragen, in wp-config.php umbenennen und hochladen. Enthält neue Sicherheitsschlüssel, ausgeschaltetes Debugging und das Tabellenpräfix des Dumps."

#: includes/Export/Report.php:60
msgid "Next steps"
msgstr "Nächste Schritte"

#: includes/Export/Report.php:63
msgid "Upload the contents of files/ via SFTP. Keep the wp-config.php that already exists on the target (it is not part of the export)."
msgstr "Den Inhalt von files/ per SFTP hochladen. Die auf dem Ziel vorhandene wp-config.php bleibt erhalten (sie ist nicht Teil des Exports)."

#: includes/Export/Report.php:67
#, php-format
msgid "Import %s in phpMyAdmin into the database of the target."
msgstr "%s in phpMyAdmin in die Datenbank des Ziels importieren."

#: includes/Export/Report.php:72
#, php-format
msgid "Check that $table_prefix in wp-config.php on the target is \"%s\"."
msgstr "Prüfen, dass $table_prefix in der wp-config.php auf dem Ziel „%s“ ist."

#: includes/Export/Report.php:75
msgid "Log in on the target (the users and passwords of the local site apply) and save Settings → Permalinks once."
msgstr "Auf dem Ziel anmelden (es gelten Benutzer und Passwörter der lokalen Seite) und einmal Einstellungen → Permalinks speichern."

#: includes/Export/Report.php:76
msgid "Clear caches, and if you use Yoast SEO run SEO → Tools → \"Optimize SEO data\"."
msgstr "Caches leeren und, falls Yoast SEO genutzt wird, SEO → Werkzeuge → „SEO-Daten optimieren“ ausführen."

#: includes/Export/Report.php:86
msgid "structure only"
msgstr "nur Struktur"

#: includes/Export/Report.php:89
#, php-format
msgid "%1$s rows, %2$s values changed"
msgstr "%1$s Zeilen, %2$s Werte geändert"

#: includes/Export/Report.php:97
msgid "Please check: references to the local site remain"
msgstr "Bitte prüfen: Verweise auf die lokale Seite verblieben"

#: includes/Export/Report.php:100
#, php-format
msgid "These values still contain %s after the replacement. Often harmless (e.g. SMTP host \"localhost\"), sometimes a spelling the plugin does not know."
msgstr "Diese Werte enthalten nach dem Ersetzen noch %s. Oft harmlos (z. B. SMTP-Host „localhost“), manchmal eine Schreibweise, die das Plugin nicht kennt."

#: includes/Export/Report.php:110
msgid "Serialized values that could not be read"
msgstr "Serialisierte Werte, die nicht gelesen werden konnten"

#: includes/Export/Report.php:111
msgid "These values look like serialized PHP data but are malformed. They were exported unchanged."
msgstr "Diese Werte sehen aus wie serialisierte PHP-Daten, sind aber fehlerhaft. Sie wurden unverändert exportiert."

#: includes/Export/Report.php:119
msgid "Linked folders"
msgstr "Verlinkte Ordner"

#: includes/Export/Report.php:125
#, php-format
msgid "Unpacked from the release zip %1$s (built %2$s)."
msgstr "Aus dem Release-Zip %1$s entpackt (erstellt %2$s)."

#: includes/Export/Report.php:129
msgid "Copied without the files listed in its .distignore."
msgstr "Ohne die in seiner .distignore aufgeführten Dateien kopiert."

#: includes/Export/Report.php:130
msgid "Copied completely (no .distignore found). Check for development files."
msgstr "Vollständig kopiert (keine .distignore gefunden). Auf Entwicklungsdateien prüfen."

#: includes/Export/Report.php:137
msgid "No server path of the target was set, so local file paths were not replaced."
msgstr "Es wurde kein Serverpfad des Ziels angegeben, daher wurden lokale Dateipfade nicht ersetzt."

#: includes/Rest/ExportController.php:80
msgid "You are not allowed to export this site."
msgstr "Du darfst diese Website nicht exportieren."

#: includes/Rest/ExportController.php:83
msgid "Exports are only possible on a local development site."
msgstr "Exporte sind nur auf einer lokalen Entwicklungsseite möglich."

#: includes/Rest/ExportController.php:99
msgid "Unknown profile."
msgstr "Unbekanntes Profil."

#: includes/Settings.php:39
msgid "The export folder must be an absolute path."
msgstr "Der Exportordner muss ein absoluter Pfad sein."

#: includes/Settings.php:43
msgid "The export folder could not be created or is not writable."
msgstr "Der Exportordner konnte nicht angelegt werden oder ist nicht beschreibbar."
