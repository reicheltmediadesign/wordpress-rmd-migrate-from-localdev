#. Plugin Name of the plugin
#: rmd-migrate-from-localdev.php
msgid "RMD Migrate from Localdev"
msgstr "RMD Migrate from Localdev"

#. Description of the plugin
#: rmd-migrate-from-localdev.php
msgid "Prepares a local development site for upload: a database dump with serialization-safe search and replace and a copy of all files, ready for SFTP and phpMyAdmin."
msgstr "Bereitet eine lokale Entwicklungsseite für den Upload vor: ein Datenbank-Dump mit serialisierungssicherem Suchen und Ersetzen und eine Kopie aller Dateien, fertig für SFTP und phpMyAdmin."

#. Author of the plugin
#: rmd-migrate-from-localdev.php
msgid "Philipp Reichelt, reichelt media.design"
msgstr "Philipp Reichelt, reichelt media.design"

#: rmd-migrate-from-localdev.php:38
#, php-format
msgid "RMD Migrate from Localdev requires PHP %1$s or newer. This site runs PHP %2$s, so the plugin stays inactive."
msgstr "RMD Migrate from Localdev benötigt PHP %1$s oder neuer. Diese Website läuft mit PHP %2$s, daher bleibt das Plugin inaktiv."

